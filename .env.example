# OpenAI
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# Gemini
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# ===========================================
# Railway deployment (backend)
# ===========================================
# MYSQL_URL is auto-provided by Railway MySQL service
# MYSQL_URL=mysql://user:pass@host:port/db

# Storage directory (Railway volume mount path)
# STORAGE_DIR=/app/storage

# Backend public URL (set to your Railway backend URL)
# BACKEND_PUBLIC_URL=https://your-app.up.railway.app

# CORS origins (JSON array or comma-separated)
# CORS_ORIGINS=["https://your-app.vercel.app"]

# ===========================================
# Vercel deployment (frontend)
# ===========================================
# NEXT_PUBLIC_API_BASE_URL=https://your-backend.up.railway.app/api/v1
# NEXT_PUBLIC_STATIC_BASE_URL=https://your-backend.up.railway.app
